# MIHAS Application System - Environment Variables Template
# Copy to .env.local and fill in your values
# Last updated: April 2, 2026
# Database: Neon Postgres | Storage: S3-compatible (S3_* in backend/.env.example) | Auth: Custom JWT
#
# NOTE: Backend-only variables are documented in backend/.env.example.
# This file covers shared and frontend (VITE_) variables.

# ===========================================
# BACKEND - Database (Neon Postgres)
# ===========================================
# Get connection string from: Neon Dashboard > Connection Details
DATABASE_URL=postgresql://[user]:[password]@[host]/[database]?sslmode=require

# ===========================================
# FRONTEND (VITE_) - Application URLs
# ===========================================
# Production backend API: https://api.beanola.com
# Development backend API: http://localhost:8000
VITE_API_BASE_URL=https://api.beanola.com
VITE_APP_BASE_URL=https://apply.beanola.com

# ===========================================
# BACKEND - Email Configuration (Resend)
# ===========================================
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=[your-resend-api-key]
EMAIL_FROM=admissions@mihas.edu.zm

# ===========================================
# OPTIONAL - SMTP Fallback (Zoho)
# ===========================================
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USERNAME=[your-smtp-username]
ZOHO_SMTP_PASSWORD=[your-smtp-password]

# ===========================================
# FRONTEND (VITE_) - Application Metadata
# ===========================================
VITE_APP_VERSION=2.0.0

# ===========================================
# FRONTEND (VITE_) - GlitchTip Error Tracking
# ===========================================
# GlitchTip DSN for frontend error reporting (Sentry-compatible).
# Get from: GlitchTip project settings > Client Keys (DSN)
VITE_GLITCHTIP_DSN=

# ===========================================
# BACKEND - GlitchTip Error Tracking
# ===========================================
# Backend DSN for server-side error reporting (Sentry-compatible).
# Same project DSN as frontend, or a separate one for backend-only errors.
GLITCHTIP_DSN=

# Optional comma-separated CIDR/IP allowlist for Lenco webhooks.
# Leave empty until Lenco publishes stable source ranges or the provider edge is known.
LENCO_WEBHOOK_ALLOWED_IPS=

# ===========================================
# FRONTEND (VITE_) - Lenco Payment Widget
# ===========================================
# Widget script URL loaded by useLencoWidget hook.
# Production: https://pay.lenco.co/js/v1/inline.js
# Sandbox:    https://pay.sandbox.lenco.co/js/v1/inline.js
VITE_LENCO_WIDGET_URL=https://pay.lenco.co/js/v1/inline.js
# Frontend dev bypass: renders "Simulate Payment (Dev)" button in PaymentStep.
# Only active when import.meta.env.DEV is true (Vite dev server).
# MUST be false or unset in production builds.
VITE_PAYMENT_DEV_BYPASS=false
# Backend dev bypass: enables POST /api/v1/payments/dev-bypass/ endpoint.
# Creates a simulated payment record without real Lenco transaction.
# Only works when DEBUG=true. MUST be false or unset in production.
PAYMENT_DEV_BYPASS=false

# ===========================================
# AI browser automation — removed
# ===========================================
# The STAGEHAND block that used to sit here (and its OPENAI_API_KEY /
# ANTHROPIC_API_KEY entries) was removed by admissions-v2 task 12.4 (R11.9,
# finding MAINT-02). Nothing in the repo reads either variable: Stagehand survives
# only in archived specs and dated audit reports, and browser automation on this
# platform is **Playwright** — the task-0.4 local harness and
# `apps/admissions/tests/harness-e2e/`, which need no model and no LLM key.
#
# A template that asks an operator to paste a real API key for a tool that is not
# installed is worse than a missing line: the key ends up in a `.env` and buys
# nothing.
#
# The one live AI key on the platform is `AI_GATEWAY_API_KEY`, which is
# **jobs-ops only** (`backend/apps/jobs/ai_service.py`, exposed to Django as
# `JOBS_OPS_AI_*`). Admissions makes no generative call — R11.1, guarded by
# `backend/tests/unit/test_no_admissions_generative_ai_guard.py`. See
# `docs/ai-data-flows.md`.
