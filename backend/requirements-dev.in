# Test packages on top of the runtime lock. Edit this file, then recompile the locks
# with the command below (platform-simplification task 5.1, R10.1/R10.4). The
# compiled `requirements.txt` is what the Dockerfile installs, hash-checked.
#
# Recompile (same image as production, pinned pip-tools):
#   docker run --rm -v "$PWD/backend:/w" -w /w python:3.12-slim sh -c "pip install pip-tools==7.6.2 && pip-compile --generate-hashes --strip-extras requirements.in && pip-compile --generate-hashes --strip-extras requirements-dev.in"
#
-r requirements.in
-c requirements.txt

