# MIHAS backend - ISOLATED LOCAL TEST ENV template (tracked; placeholders only).
#
# Copy to backend/.env.local.test (gitignored) before starting the stack:
#   cp .env.local.test.example .env.local.test
#
# Loaded by docker-compose.local-test.yml. It points at the LOCAL Postgres and
# Redis in that file and uses fake values for every external integration, so a
# local run can never reach Neon, production, or real Lenco / email / AI.
# Object storage is NOT configured here: the compose file gives web and celery a
# private MinIO bucket directly (S3_* in its `environment:` block).
#
# If you already have a .env.local.test, delete its USE_LOCAL_FILE_STORAGE and
# CELERY_TASK_ALWAYS_EAGER lines: nothing reads either of them.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=local-test-secret-key-not-for-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LOCAL database (the throwaway test DB, NOT Neon) ---
POSTGRES_DB=mihas_localtest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mihas_localtest
DB_SSL_REQUIRE=false

# --- LOCAL redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# --- External integrations: fake or disabled so nothing leaves the machine ---
# Payments (Lenco): placeholders; do not initiate real collections.
LENCO_API_SECRET_KEY=local-test-lenco-secret
LENCO_API_BASE_URL=https://sandbox.lenco.invalid/access/v2/
LENCO_PUBLIC_KEY=local-test-lenco-public

# Email: console backend, emails print to the logs and are never sent.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ERROR_ALERT_EMAIL=alerts@example.invalid

# AI gateway: empty so jobs-ops AI features degrade gracefully.
AI_GATEWAY_API_KEY=

# Error monitoring: empty DSN so nothing is reported.
GLITCHTIP_DSN=

# --- Auth and crypto keys (local-only dummies) ---
JWT_SIGNING_KEY=local-test-jwt-signing-key-not-for-production
AUDIT_LOG_ENCRYPTION_KEY=local-test-audit-key-0123456789abcdef
