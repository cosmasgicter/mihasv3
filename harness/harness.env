# Admissions V2 local E2E harness environment — LOCAL, DISPOSABLE, NON-PRODUCTION.
#
# Every value here is a local/deterministic placeholder for a throwaway stack
# (postgres/postgres as in any throwaway local database).
# There are NO production credentials here and this stack never reaches Neon,
# Cloudflare R2, Zoho, Resend, or the real Lenco gateway. Safe to commit.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.harness
ENVIRONMENT=harness
SECRET_KEY=harness-insecure-secret-key-do-not-use-anywhere-real
JWT_SIGNING_KEY=harness-insecure-jwt-signing-key
AUDIT_LOG_ENCRYPTION_KEY=harness-audit-key-0123456789abcdef0123
DEBUG=

# --- Data stores (compose service names) ----------------------------------
POSTGRES_DB=harness
POSTGRES_USER=harness
POSTGRES_PASSWORD=harness
DATABASE_URL=postgres://harness:harness@postgres:5432/harness
DB_SSL_REQUIRE=false
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# --- Hosts / CORS (two example tenant hosts + neutral) --------------------
ALLOWED_HOSTS=localhost,127.0.0.1,web,caddy,testserver,.localhost,mihas.localhost,katc.localhost
CORS_ALLOWED_ORIGINS=http://localhost:8090,http://mihas.localhost:8090,http://katc.localhost:8090
CSRF_TRUSTED_ORIGINS=http://localhost:8090,http://mihas.localhost:8090,http://katc.localhost:8090,http://localhost:8000,http://127.0.0.1:8000

# --- Object storage -> local MinIO (S3-compatible) ------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=harness
S3_ACCESS_KEY=harnessminio
S3_SECRET_KEY=harnessminiosecret
MINIO_ROOT_USER=harnessminio
MINIO_ROOT_PASSWORD=harnessminiosecret

# --- Email -> Mailpit console/test inbox (never Zoho/Resend) --------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_FROM=no-reply@harness.beanola.local
RESEND_API_KEY=harness-unused-resend-key

# --- Payment -> deterministic Lenco-compatible adapter --------------------
LENCO_API_BASE_URL=http://adapters:9099
LENCO_API_SECRET_KEY=harness-lenco-secret
LENCO_PUBLIC_KEY=harness-lenco-public

# --- Domain verification -> deterministic domain adapter ------------------
HARNESS_DOMAIN_ADAPTER_URL=http://adapters:9099/dns

# --- Health / frontend ----------------------------------------------------
HEALTH_CHECK_URL=http://web:8000/health/ready/
FRONTEND_URL=http://localhost:8090

# --- Harness bootstrap identities (LOCAL test accounts only) --------------
HARNESS_SUPERADMIN_EMAIL=platform-admin@harness.beanola.local
HARNESS_SUPERADMIN_PASSWORD=HarnessPlatform123!
HARNESS_TENANT_ADMIN_PASSWORD=HarnessTenant123!
